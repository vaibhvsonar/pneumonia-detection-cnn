# ==============================================================================
# Environment Variables for Pneumonia Detection Cloud Deployment
# ==============================================================================

# 1. Server Configuration
# Note: On Render, DO NOT set PORT manually; Render assigns PORT=10000 automatically.
PORT=10000
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate_a_random_secure_secret_key_here

# 2. Model Settings (Optional, defaults to best_pneumonia_model.pth)
MODEL_PATH=best_pneumonia_model.pth

# 3. Cloud Memory & CPU Optimization (Recommended for Free Tier Servers)
# Prevents PyTorch from spinning up too many parallel threads on shared cloud CPU cores
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# 4. Python Version Specification (For Render / Railway)
PYTHON_VERSION=3.11.9

# 5. Frontend-to-Backend URL (Only if hosting the frontend on Vercel separately)
# BACKEND_URL=https://your-pneumonia-api.onrender.com

